# good-techstack — .gitignore

# ── Runtime ──
node_modules/

# ── Environment ──
.env
.env.local
.env.production
.dev.vars

# ── Build output ──
dist/
build/
.next/
out/

# ── Cloudflare ──
.wrangler/

# ── Nix / devenv ──
.devenv/
devenv.local.nix
# generated by git-hooks.nix (machine-specific nix-store paths)
.pre-commit-config.yaml

# ── IDE / OS ──
.DS_Store
*.swp
*.swo
*~

# ── TypeScript ──
*.tsbuildinfo

# ── Generated (TanStack Router) ──
.tanstack/

# ── Agent instructions (not committed) ──
AGENTS.md

# Local dev DB snapshots (seed caching)
*.snapshot.db

# ── Stryker mutation testing (generated during runs) ──
stryker-setup-*.js
reports/mutation/

