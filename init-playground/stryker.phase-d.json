{
  "$schema": "node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/server/db/schema.ts", "tests/db-common.ts"],
  "testRunner": "vitest",
  "concurrency": 4,
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation-phase-d/html/index.html"
  },
  "tempDirName": "reports/mutation-phase-d/.stryker-tmp",
  "inPlace": true,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 70
  },
  "plugins": ["@stryker-mutator/vitest-runner"]
}
