{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gstack",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/entry-server.tsx",
  "assets": {
    "directory": "dist/client",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gstack-db",
      "database_id": "__D1_ID__",
      "migrations_dir": "./drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "gstack-assets",
      "preview_bucket_name": "gstack-assets-preview",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "__KV_ID__",
      "preview_id": "__KV_PREVIEW_ID__",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "gstack-queue",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENTS_DO",
        "class_name": "EventsDO",
        "script_name": "gstack",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "RATELIMIT",
      "namespace_id": "__RATELIMIT_ID__",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "__EMAIL_ADDRESS__",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "__AUTH_URL__",
    "TURNSTILE_SECRET_KEY": "__TURNSTILE_SECRET__",
    "USE_MOCKS": "false",
    "WEB_ANALYTICS_TOKEN": "__WA_TOKEN__",
  },
}
