{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gstack-bench",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/bench/worker.ts",
  "assets": {
    "directory": "dist/client",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gstack-db",
      "database_id": "__D1_ID__",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "gstack-assets",
      "preview_bucket_name": "gstack-assets-preview",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "__KV_ID__",
      "preview_id": "__KV_PREVIEW_ID__",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENTS_DO",
        "class_name": "EventsDO",
        "script_name": "gstack-bench",
      },
    ],
  },
  "vars": {
    "BETTER_AUTH_URL": "__AUTH_URL__",
    "BETTER_AUTH_SECRET": "__AUTH_SECRET__",
    "TURNSTILE_SECRET_KEY": "__TURNSTILE_SECRET__",
    "USE_MOCKS": "false",
    "WEB_ANALYTICS_TOKEN": "__WA_TOKEN__",
  },
}
