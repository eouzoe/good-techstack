{
  "name": "good-techstack",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "cd apps/backend && bunx wrangler dev --ip 127.0.0.1",
    "dev:frontend": "cd apps/frontend && bunx rsbuild dev",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "typecheck": "cd apps/backend && tsc --noEmit && cd ../frontend && tsc --noEmit",
    "test": "cd apps/backend && bun test --pass-with-no-tests && cd ../frontend && bunx rstest",
    "deploy:backend": "cd apps/backend && bunx wrangler deploy",
    "deploy:frontend": "cd apps/frontend && bunx rsbuild build"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.168.27",
    "@tanstack/react-start": "^1.168.27",
    "better-auth": "^1.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.2025",
    "@rsbuild/core": "^2.1.6",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/adapter-rsbuild": "^0.11.2",
    "@rstest/core": "^0.11.2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^25",
    "oxlint": "^0.15.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.112.0"
  }
}
